#!/bin/bash

operate=${1}

if [[ ${operate} == "sync" ]]; then
  code="export let name = \"${2}\";"
  # ctl=wpaperctl

  if [[ ${2} == "wallpaper" ]]; then
    # wallust -q -I background run $("${ctl}" get $("${ctl}" status | jq -R 'split(": ") | .[0]'))
    wallust -q -I background run $(awww query -j | jq -r '."".[0].displaying.image')
  else
    colorscheme=$(yolk eval "write_current_colorscheme(\"${2}\")")
    echo "${colorscheme}" >~/.config/wallust/colorschemes/terminal.json && wallust -q -T cs terminal
  fi
  echo "${code}" >~/.config/yolk/theme.rhai && yolk sync && eww-window close platte && dunstctl reload
elif [[ ${operate} == "update" ]]; then
  sleep 0.02
  eww update activeworkspace="$(eww-tools get_activeworkspace_id)"
  eww-volume getinitvol
  eww update applist="$(eww-tools get_app_list)"
  eww update workspaces="$(eww-tools get_workspaces)"
  eww update activewindow="$(eww-tools get_activewindow_id)"
fi
