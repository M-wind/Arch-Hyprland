spawn-sh-at-startup "~/app/wallpaper/swaybg -i ~/background/backdrop.jpg"
spawn-sh-at-startup "~/app/wallpaper/wpaperd -d"
spawn-sh-at-startup "clipse -listen"
spawn-sh-at-startup "eww-niriipc"
spawn-sh-at-startup "eww daemon && eww open bar && eww-volume getinitvol"
spawn-sh-at-startup "fcitx5 -d && fcitx5_tray"
screenshot-path "~/screenshots/%Y-%m-%d %H-%M-%S.png"
prefer-no-csd
hotkey-overlay {
    skip-at-startup
}
xwayland-satellite {
    off
}
// config-notification {
//   disable-failed
// }
gestures {
    hot-corners {
        off
    }
}
input {
    keyboard {
        numlock
    }
    mouse {
        accel-speed -0.6
        accel-profile "adaptive"
    }
    mod-key "Super"
    mod-key-nested "Alt"
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}
recent-windows {
    debounce-ms 50
    open-delay-ms 50
    highlight {
        // {# replace_quoted(theme.colors.cyan) #}
        active-color "#29a298"
        padding 6
        corner-radius 8
    }
    previews {
        max-height 480
        max-scale 0.5
    }
    binds {
        Mod+Period {
            next-window scope="workspace"
        }
        Mod+Comma {
            previous-window scope="workspace"
        }
        Mod+Shift+Period {
            next-window filter="app-id"
        }
        Mod+Shift+Comma {
            previous-window filter="app-id"
        }
    }
}
layout {
    gaps 6
    struts {
        left 0
        right 0
        top 0
        bottom -6
    }
    center-focused-column "never"
    // always-center-single-column
    focus-ring {
        width 2
        // {# replace_quoted(theme.colors.cyan) #}
        active-color "#29a298"
        inactive-color "#505050"
    }
    border {
        off
    }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
 /* blur {
        on
        radius 2
        passes 3
        noise 0.0
    } */
}
overview {
    zoom 0.69
}
debug {

}
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
window-rule {
    match app-id="alacritty"
    draw-border-with-background false
 // opacity 0.69
}
window-rule {
    match app-id="clipse"
    open-floating true
    default-column-width {
        fixed 720
    }
    default-window-height {
        fixed 480
    }
}
window-rule {
    match app-id="btop"
    open-floating true
    default-column-width {
        fixed 1536
    }
    default-window-height {
        fixed 864
    }
}
window-rule {
    match app-id="yazi"
    open-floating true
    default-column-width {
        fixed 1280
    }
    default-window-height {
        fixed 726
    }
}
window-rule {
    match app-id="mpv"
    open-floating true
    default-column-width {
        fixed 1280
    }
    default-window-height {
        fixed 720
    }
}
window-rule {
    match app-id="neovide"
    draw-border-with-background false
    opacity 0.69
    default-column-width {
        fixed 1831
    }
    default-window-height {
        fixed 1035
    }
    // min-width 1831
    // min-height 1035
    open-floating true
    open-maximized false
    open-fullscreen false
}
window-rule {
    match title="画中画"
    open-floating true
    default-column-width {
        fixed 1920
    }
    default-window-height {
        fixed 1080
    }
}
layer-rule {
    match namespace="wallpaper"
    place-within-backdrop true
}
binds {
    Mod+T hotkey-overlay-title="Open Terminal: Foot" repeat=false {
        spawn-sh "foot -d none"
    }
    Mod+E hotkey-overlay-title="Open File Manager: Yazi" repeat=false {
        spawn-sh "foot -d none -a yazi -e yazi"
    }
    Mod+Shift+V hotkey-overlay-title="Open Clipboard: Clipse" repeat=false {
        spawn-sh "foot -d none -a clipse -e clipse"
    }
    Mod+C hotkey-overlay-title="Color Picker" repeat=false {
        spawn-sh "colorpicker -a"
    }
    Ctrl+Shift+Escape hotkey-overlay-title="Open System Moniter: Btop" repeat=false {
        spawn-sh "foot -d none -a btop -e btop"
    }
    Mod+B hotkey-overlay-title="Open Browser: Zen" repeat=false {
        spawn "~/app/zen/zen"
    }
    Mod+W repeat=false {
        close-window
    }
    Mod+M hotkey-overlay-title="Open Video Player: Mpv" repeat=false {
        spawn-sh "mpv --player-operation-mode=pseudo-gui"
    }
    Mod+N hotkey-overlay-title="Open Text Editer: Neovide" repeat=false {
        spawn "neovide"
    }
    Mod+D hotkey-overlay-title="Toggle Window Bar" repeat=false {
        spawn-sh "eww-window toggle bar"
    }
    Mod+V repeat=false {
        toggle-window-floating
    }
    Mod+Shift+O repeat=false {
        toggle-overview
    }
    Mod+BracketLeft hotkey-overlay-title="Previous Wallpaper" repeat=false {
        spawn-sh "~/app/wallpaper/wpaperctl previous"
    }
    Mod+BracketRight hotkey-overlay-title="Next Wallpaper" repeat=false {
        spawn-sh "~/app/wallpaper/wpaperctl next"
    }
    Mod+Left {
        focus-column-left
    }
    Mod+Down {
        focus-window-down
    }
    Mod+Up {
        focus-window-up
    }
    Mod+Right {
        focus-column-right
    }
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+R {
        center-window
    }
    Mod+P repeat=false {
        switch-preset-column-width
    }
    Mod+O repeat=false {
        switch-preset-window-height
    }
    Mod+Shift+BracketLeft {
        move-window-to-workspace-down
    }
    Mod+Shift+BracketRight {
        move-window-to-workspace-up
    }
    Mod+F repeat=false {
        maximize-column
    }
    Mod+Shift+F repeat=false {
        fullscreen-window
    }
    Mod+I repeat=false {
        show-hotkey-overlay
    }
    Mod+Shift+Q repeat=false {
        quit skip-confirmation=true
    }
    Mod+Shift+C repeat=false {
        switch-focus-between-floating-and-tiling
    }
    Mod+Alt+J {
        focus-workspace-down
    }
    Mod+Alt+K {
        focus-workspace-up
    }
    Mod+Alt+H repeat=false {
        consume-or-expel-window-left
    }
    Mod+Alt+L repeat=false {
        consume-or-expel-window-right
    }
    Mod+Shift+Left {
        move-column-left
    }
    Mod+Shift+Down {
        move-window-down
    }
    Mod+Shift+Up {
        move-window-up
    }
    Mod+Shift+Right {
        move-column-right
    }
    Mod+Shift+H {
        move-column-left
    }
    Mod+Shift+J {
        move-window-down
    }
    Mod+Shift+K {
        move-window-up
    }
    Mod+Shift+L {
        move-column-right
    }
    Mod+1 repeat=false {
        focus-workspace 1
    }
    Mod+2 repeat=false {
        focus-workspace 2
    }
    Mod+3 repeat=false {
        focus-workspace 3
    }
    Mod+4 repeat=false {
        focus-workspace 4
    }
    Mod+5 repeat=false {
        focus-workspace 5
    }
    Mod+6 repeat=false {
        focus-workspace 6
    }
    Mod+Shift+1 repeat=false {
        move-column-to-workspace 1
    }
    Mod+Shift+2 repeat=false {
        move-column-to-workspace 2
    }
    Mod+Shift+3 repeat=false {
        move-column-to-workspace 3
    }
    Mod+Shift+4 repeat=false {
        move-column-to-workspace 4
    }
    Mod+Shift+5 repeat=false {
        move-column-to-workspace 5
    }
    Mod+Shift+6 repeat=false {
        move-column-to-workspace 6
    }
    Mod+Ctrl+J {
        set-window-height "-10%"
    }
    Mod+Ctrl+K {
        set-window-height "+10%"
    }
    Mod+Ctrl+H {
        set-column-width "-10%"
    }
    Mod+Ctrl+L {
        set-column-width "+10%"
    }
    Mod+Ctrl+M hotkey-overlay-title="Toggle Mute" repeat=false {
        spawn-sh "eww-volume togglebykey"
    }
    XF86AudioMute hotkey-overlay-title="Toggle Mute" repeat=false {
        spawn-sh "eww-volume togglebykey"
    }
    Mod+Ctrl+Equal hotkey-overlay-title="Volume +5" {
        spawn-sh "eww-volume adjustbykey 0.05"
    }
    Mod+Ctrl+Minus hotkey-overlay-title="Volume -5" {
        spawn-sh "eww-volume adjustbykey -0.05"
    }
    Mod+Ctrl+BackSpace hotkey-overlay-title="Volume Default" repeat=false {
        spawn-sh "eww-volume defaultbykey"
    }
    // Print repeat=false { screenshot-screen; }
    // Mod+Shift+S hotkey-overlay-title="Open ScreenShot" repeat=false { screenshot; }
    Print hotkey-overlay-title="ScreenShot full" repeat=false {
        spawn-sh "screentool -n -t capture -s full -f ~/screenshots/full-$(date +'%F-%T-%N.png')"
    }
    Mod+Shift+S hotkey-overlay-title="ScreenShot area" repeat=false {
        spawn-sh "screentool -n -t capture -s area -f ~/screenshots/area-$(date +'%F-%T-%N.png')"
    }
    // Ctrl+Alt+L hotkey-overlay-title="Screen Lock" repeat=false {
    //     spawn "screenlock"
    // }
}

