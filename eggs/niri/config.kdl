spawn-sh-at-startup "~/app/wallpaper/wpaperd -d"
spawn-sh-at-startup "fcitx5 -d"
spawn-sh-at-startup "clipse -listen"
spawn-sh-at-startup "eww daemon && eww-env && eww-volume getDefaultVolume && eww open bar"
spawn-sh-at-startup "eww-niriipc"

screenshot-path "~/screenshots/%Y-%m-%d %H-%M-%S.png"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

xwayland-satellite {
  off
}

input {
  keyboard {
    numlock
  }
  focus-follows-mouse max-scroll-amount="0%"
}

layout {
  gaps 6
  struts {
    left 0
    right 0
    top 0
    bottom -6
  }
  center-focused-column "never"
  always-center-single-column
  focus-ring {
    width 2
    active-color "#7fc8ff"
    inactive-color "#505050"
  }
  border {
    off
  }
  blur {
    on
    radius 2
    passes 5
    noise 0.0
  }
}

overview {
  zoom 0.69
}

window-rule {
  geometry-corner-radius 8
  clip-to-geometry true
 }

window-rule {
  match app-id="clipse"
  open-floating true
  default-column-width { fixed 720; }
  default-window-height { fixed 480; }
}

window-rule {
  match app-id="btop"
  open-floating true
  default-column-width { fixed 1536; }
  default-window-height { fixed 864; }
}

window-rule {
  match app-id="yazi"
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 726; }
}

window-rule {
  match app-id="mpv"
  open-floating true
  default-column-width { fixed 1280; }
  default-window-height { fixed 720; }
}

window-rule {
  match app-id="neovide"
  open-floating true
  draw-border-with-background false
  opacity 0.79
  default-column-width { fixed 1831; }
  default-window-height { fixed 1035; }
}

// layer-rule {
//   match namespace="bar"
//   place-within-backdrop true
// }

binds {
  Super+T hotkey-overlay-title="Open Terminal: Foot" repeat=false { spawn-sh "foot -d none"; }
  Super+B hotkey-overlay-title="Open Browser: Zen" repeat=false { spawn "~/app/zen/zen"; }
  Super+E hotkey-overlay-title="Open File Manager: Yazi" repeat=false { spawn-sh "foot -d none -a yazi -T yazi yazi"; }
  Super+W repeat=false { close-window; }
  Super+M hotkey-overlay-title="Open Video Player: Mpv" repeat=false { spawn-sh "mpv --player-operation-mode=pseudo-gui"; }
  Super+N hotkey-overlay-title="Open Text Editer: Neovide" repeat=false { spawn "neovide"; }
  Super+D hotkey-overlay-title="Toggle Window Bar" repeat=false { spawn-sh "eww-window toggle bar"; }

  Super+V repeat=false { toggle-window-floating; }
  Super+O repeat=false { toggle-overview; }

  Super+BracketLeft hotkey-overlay-title="Previous Wallpaper" repeat=false { spawn-sh "~/app/wallpaper/wpaperctl previous"; }
  Super+BracketRight hotkey-overlay-title="Next Wallpaper" repeat=false { spawn-sh "~/app/wallpaper/wpaperctl next"; }
  
  Super+Left { focus-column-left; }
  Super+Down { focus-window-down; }
  Super+Up { focus-window-up; }
  Super+Right { focus-column-right; }
  Super+H { focus-column-left; }
  Super+J { focus-window-down; }
  Super+K { focus-window-up; }
  Super+L { focus-column-right; }
  Super+R { center-window; }
  Super+P { switch-preset-column-width; }
  Super+Shift+BracketLeft { move-window-to-workspace-down; }
  Super+Shift+BracketRight { move-window-to-workspace-up; }

  Super+F repeat=false { maximize-column; }

  Super+Shift+F repeat=false { fullscreen-window; }
  Super+Shift+O repeat=false { show-hotkey-overlay; }
  Super+Shift+Q repeat=false { quit skip-confirmation=true; }
  Super+Shift+C repeat=false { switch-focus-between-floating-and-tiling; }
  Super+Shift+V hotkey-overlay-title="Open Clipboard: Clipse" repeat=false { spawn-sh "foot -d none -a clipse -T clipse clipse"; }

  Ctrl+Shift+Escape hotkey-overlay-title="Open System Moniter: Btop" repeat=false { spawn-sh "foot -d none -a btop -T btop btop"; }

  Super+Alt+J { focus-workspace-down; }
  Super+Alt+K { focus-workspace-up; }
  Super+Alt+H repeat=false { consume-or-expel-window-left; }
  Super+Alt+L repeat=false { consume-or-expel-window-right; }


  Super+Shift+Left { move-column-left; }
  Super+Shift+Down { move-window-down; }
  Super+Shift+Up { move-window-up; }
  Super+Shift+Right { move-column-right; }
  Super+Shift+H { move-column-left; }
  Super+Shift+J { move-window-down; }
  Super+Shift+K { move-window-up; }
  Super+Shift+L { move-column-right; }

  Super+1 repeat=false { focus-workspace 1; }
  Super+2 repeat=false { focus-workspace 2; }
  Super+3 repeat=false { focus-workspace 3; }
  Super+4 repeat=false { focus-workspace 4; }
  Super+5 repeat=false { focus-workspace 5; }
  Super+6 repeat=false { focus-workspace 6; }
  Super+Shift+1 repeat=false { move-column-to-workspace 1; }
  Super+Shift+2 repeat=false { move-column-to-workspace 2; }
  Super+Shift+3 repeat=false { move-column-to-workspace 3; }
  Super+Shift+4 repeat=false { move-column-to-workspace 4; }
  Super+Shift+5 repeat=false { move-column-to-workspace 5; }
  Super+Shift+6 repeat=false { move-column-to-workspace 6; }

  Super+Ctrl+J { set-window-height "-10%"; }
  Super+Ctrl+K { set-window-height "+10%"; }
  Super+Ctrl+H { set-column-width "-10%"; }
  Super+Ctrl+L { set-column-width "+10%"; }

  Super+Ctrl+M hotkey-overlay-title="Toggle Mute" repeat=false { spawn-sh "eww-volume togglebykey"; }
  XF86AudioMute hotkey-overlay-title="Toggle Mute" repeat=false { spawn-sh "eww-volume togglebykey"; }
  Super+Ctrl+Equal hotkey-overlay-title="Volume +5" { spawn-sh "eww-volume adjustbykey 0.05"; }
  Super+Ctrl+Minus hotkey-overlay-title="Volume -5" { spawn-sh "eww-volume adjustbykey -0.05"; }
  Super+Ctrl+BackSpace hotkey-overlay-title="Volume Default" repeat=false { spawn-sh "eww-volume defaultbykey"; }

  Print repeat=false { screenshot-screen; }
  Super+Shift+S hotkey-overlay-title="Open ScreenShot" repeat=false { screenshot; }
  
}
