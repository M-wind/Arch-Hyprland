layer-rule {
    match namespace="bar-right-slide"
    geometry-corner-radius 8
    background-effect {
        xray true
        blur true
    }
}
layer-rule {
    match namespace="bar-center-slide"
    geometry-corner-radius 8
    background-effect {
        xray true
        blur true
    }
}
layer-rule {
    match namespace="bar-center-popin"
    geometry-corner-radius 8
    background-effect {
        xray true
        blur true
    }
}

