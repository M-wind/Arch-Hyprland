{
  "allowDuplicates": false,
  "historyFile": "clipboard_history.json",
  "maxHistory": 100,
  "deleteAfter": 0,
  "logFile": "clipse.log",
  "pollInterval": 50,
  "maxEntryLength": 65,
  "themeFile": "custom_theme.json",
  "tempDir": "tmp_files",
  "keyBindings": {
    "choose": "enter",
    "clearSelected": "V",
    "down": "j,down",
    "up": "k,up",
    "end": "end",
    "filter": "/",
    "home": "home",
    "more": "?",
    "nextPage": "l,right",
    "prevPage": "h,left",
    "preview": "space",
    "quit": "ctrl+q",
    "remove": "d",
    "selectDown": "ctrl+j,ctrl+down",
    "selectSingle": "v",
    "selectUp": "ctrl+k,ctrl+up",
    "togglePin": "p",
    "togglePinned": "tab",
    "yankFilter": "y"
  },
  "imageDisplay": {
    "type": "sixel",
    "scaleX": 9,
    "scaleY": 9,
    "heightCut": 2
  },
  "excludedApps": [],
  "autoPaste": {
    "enabled": false,
    "keybind": "ctrl+v",
    "buffer": 10
  },
  "enableMouse": true,
  "enableDescription": true
}
