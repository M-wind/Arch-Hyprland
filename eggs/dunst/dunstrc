[niri_config]
    appname = niri-config
    urgency = critical
    history_ignore = true
    timeout = 9
    format = "<span font_weight='bold' font_style='italic' line_height='1.5pt' color='#db302d'>%s</span>\n%b"
    new_icon = niri
    icon_position = right
    skip_display = false

