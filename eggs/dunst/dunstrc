# dunst config

[global]
    monitor = 0
    follow = none
    enable_posix_regex = true
    width = (144, 512)
    height = (0, 320)
    notification_limit = 10
    origin = bottom-right
    offset = (6, 0)
    progress_bar = false
    icon_corner_radius = 8
    min_icon_size = 24
    max_icon_size = 256
    separator_height = 6
    padding = 12
    horizontal_padding = 12
    # text_icon_padding = 12
    frame_width = 0
    separator_height = 0
    gap_size = 6
    sort = update
    # line_height = 2
    idle_threshold = 0
    font = monospace 13
    # {# replace_color_by_index(theme.colors.green, -37, -32) #}
    format = "<span font_weight='bold' font_style='italic' color='#a6e3a1'>%s</span>\n<small>%b</small>"
    vertical_alignment = center
    show_age_threshold = -1
    browser = "handlr open"
    always_run_script = true
    corner_radius = 8
    override_pause_level = 100
    override_dbus_timeout = 5
    show_indicators=false
    alignment = "right"
    icon_path = ~/app/notify/icons
    # icon_position = "off"
    mouse_left_click = "open_url"
    mouse_middle_click = "none"
    mouse_right_click = "close_current"
    # {# replace_niri_shadow(theme.colors.background) #}
    background = "#0014198f"
    foreground = "#cdd6f4" # {< replace_color(theme.colors.foreground) >}
    # default_icon = notifyl
    default_icon = " "
    skip_display = true
    # script = eww-notify
    # compatible with niri exit code 127
    script = ~/.config/eww/scripts/eww-notify


# [urgency_low]
#     default_icon = notifyl
#     skip_display = true 
#
# [urgency_normal]
#     default_icon = notifyn
#     skip_display = true 
#
# [urgency_critical]
#     default_icon = notifyc
#     skip_display = true 

[niri_config]
    appname = niri-config
    urgency = critical
    history_ignore = true
    override_dbus_timeout = 9
    # {# replace_color_by_index(theme.colors.red, -22, -17) #}
    format = "<span font_weight='bold' font_style='italic' line_height='1.5pt' color='#f38ba8'>%s</span>\n%b"
    new_icon = niri
    icon_position = right
    skip_display = false

